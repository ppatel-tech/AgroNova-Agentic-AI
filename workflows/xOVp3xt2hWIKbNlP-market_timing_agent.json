        "jsCode": "// n8n ab $json mein purani searchDate lekar aayega kyunki humne 'Include Input Fields' on kar diya hai\nlet currentSearchDate = $json.searchDate;\n\n// Agar kisi wajah se pehli baar hai aur searchDate nahi mili\nif (!currentSearchDate) {\n    currentSearchDate = $('current date').item.json.searchDate;\n}\n\n// 1 din ghatao\nconst previousDate = DateTime.fromFormat(currentSearchDate, \"dd/MM/yyyy\").minus({ days: 1 }).toFormat(\"dd/MM/yyyy\");\n\nreturn {\n  searchDate: previousDate,\n  district_array: $json.district_array // district bhi aage bhej rahe hain\n};"
