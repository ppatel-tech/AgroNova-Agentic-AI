    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Step 1: Deep path se actual text nikaalo\nlet rawText = $json?.content?.parts?.[0]?.text || \"\";\n\n// Step 2: JSON block extract karo (safe approach)\nlet match = rawText.match(/\\{[\\s\\S]*\\}/);\n\nlet data = {};\n\nif (match) {\n  try {\n    data = JSON.parse(match[0]);\n  } catch (e) {\n    data = {};\n  }\n}\n\n// Step 3: Final structured output return karo\nreturn {\n  recommended_fertilizers: data.recommended_fertilizers || [],\n  \n  user_fertilizer: {\n    name: data.user_fertilizer?.name || \"not provided\",\n    status: data.user_fertilizer?.status || \"not_provided\",\n    quantity_per_acre: data.user_fertilizer?.quantity_per_acre || \"not applicable\",\n    total_quantity: data.user_fertilizer?.total_quantity || \"not applicable\"\n  },\n\n  tips: data.tips || []\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        -64
      ],
      "id": "c7018837-3815-4b04-853e-e73133441a79",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nlet finalData = {};\n\n// 1. STRICT CHECK: Check karo ki 'data' naam ka binary object exist karta hai ya nahi\nif (item.binary && item.binary.data) {\n  // Scenario A: Data binary file me aaya hai\n  const binaryDataBuffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n  const jsonString = binaryDataBuffer.toString('utf-8');\n  finalData = JSON.parse(jsonString);\n} \n// 2. Agar binary nahi hai, toh check karo ki standard body aayi hai kya\nelse if (item.json && item.json.body) {\n  // Scenario B: Data normally JSON body me aaya hai\n  finalData = item.json.body;\n} \n// 3. Failsafe (Agar dono hi format nahi mile)\nelse {\n  finalData = item.json; \n}\n\n// 4. Saari binary fields collect karo (agar koi 'data' ke alawa images wagerah aayi hain)\nconst allBinaries = {};\nif (item.binary) {\n  for (const key of Object.keys(item.binary)) {\n    if (key !== 'data') {\n      allBinaries[key] = item.binary[key];\n    }\n  }\n}\n\n// 5. Final item construct karo\nconst outputItem = {\n  json: {\n    ...finalData\n  }\n};\n\n// Binary object sirf tabhi attach karo jab actually koi aur image bachi ho\nif (Object.keys(allBinaries).length > 0) {\n  outputItem.binary = allBinaries;\n}\n\nreturn [outputItem];"
      },
